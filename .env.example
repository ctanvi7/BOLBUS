# Copy to backend/.env (run backend commands from backend/)
DATABASE_URL=sqlite:///./bolbus.db
CORS_ORIGINS=["http://localhost:5173"]
# Optional frontend/.env.local setting; default uses Vite /api proxy
# VITE_API_BASE_URL=http://localhost:8000
# Provider credentials belong only on the server.

# Speech: disabled (default), fixture (explicit developer samples), gnani (real REST)
SPEECH_MODE=disabled
GNANI_API_KEY=
# No secrets in frontend VITE_* variables. Restart the backend after changes.
